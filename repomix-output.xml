const describeDevPostgres = process.env.TAX_BACKFILL_TEST_URL ? describe : describe.skip;

/** Schema fixture chỉ tồn tại trong transaction và bị rollback toàn bộ sau suite. */
describeDevPostgres('Loại tích lũy sản phẩm trên PostgreSQL DEV cô lập', () => {
  jest.setTimeout(60000);
  const schema = `reward_fixture_${process.pid}_${Date.now()}`;
  const migration = new AddProductRewardExclusion1786392000000();
  let connection: DataSource;
  let runner: QueryRunner;
  let service: CustomerRewardService;

  beforeAll(async () => {
    const url = process.env.TAX_BACKFILL_TEST_URL!;
    if (new URL(url).hostname !== 'ep-broad-pine-a1675nqi-pooler.ap-southeast-1.aws.neon.tech') {
      throw new Error('Suite chỉ được chạy trên DB DEV đã xác minh');
    }
    connection = new DataSource({
      type: 'postgres', url, ssl: { rejectUnauthorized: false },
      schema, entities: [join(__dirname, '../../entities/*.entity.ts')],
      synchronize: false, logging: false, extra: { max: 2, statement_timeout: 15000 },
    });
    await connection.initialize();
    runner = connection.createQueryRunner();
    await runner.connect();
    const [identity] = await runner.query('SELECT current_database() AS db');
    if (identity.db !== decodeURIComponent(new URL(url).pathname.slice(1))) {
      throw new Error('Danh tính database không khớp cấu hình DEV');
    }
    await runner.startTransaction();
    await runner.query(`CREATE SCHEMA "${schema}"`);
    await runner.query(`SET LOCAL search_path TO "${schema}", public`);
    // Chỉ sao chép cấu trúc cột, không sao chép một dòng dữ liệu thật nào.
    for (const table of [
      'customers', 'seasons', 'products', 'sales_invoices', 'sales_invoice_items',
      'customer_reward_tracking', 'customer_reward_history', 'debt_notes',
      'system_settings', 'sales_returns', 'sales_return_items', 'payments',
      'payment_allocations', 'debt_note_closures',
      'loans',
    ]) {
      await runner.query(`CREATE TABLE "${schema}"."${table}" AS SELECT * FROM public."${table}" WITH NO DATA`);
      await runner.query(`ALTER TABLE "${schema}"."${table}" ADD PRIMARY KEY (id)`);
    }
    for (const table of ['customer_reward_tracking', 'payments', 'payment_allocations', 'debt_note_closures']) {
      await runner.query(`ALTER TABLE "${schema}"."${table}" ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (START WITH 100)`);
    }
    await runner.query('ALTER TABLE customer_reward_tracking ADD UNIQUE (customer_id)');
    await runner.query('ALTER TABLE products DROP COLUMN IF EXISTS exclude_from_reward');
    await runner.query('ALTER TABLE sales_invoice_items DROP COLUMN IF EXISTS exclude_from_reward');
    await runner.query('ALTER TABLE sales_invoices DROP COLUMN IF EXISTS reward_policy_version');
    await runner.query('INSERT INTO customers (id) VALUES (7)');
    await runner.query("INSERT INTO customer_reward_tracking (id,customer_id,pending_amount,total_accumulated,reward_count,status) VALUES (1,7,1000,1000,0,'active')");
    await runner.query("INSERT INTO sales_invoices (id,customer_id,season_id,status,final_amount,partial_payment_amount,remaining_amount) VALUES (90,7,3,'confirmed',1000,100,900)");
    service = new CustomerRewardService(
      runner.manager.getRepository(CustomerRewardTracking),
      runner.manager.getRepository(CustomerRewardHistory),
      runner.manager.getRepository(DebtNote),
      runner.manager.getRepository(SystemSetting),
      {} as FarmGiftCostService,
      {} as InventoryService,
    );
  });

  beforeEach(async () => { await runner.query('SAVEPOINT reward_case'); });
  afterEach(async () => {
    if (runner?.isTransactionActive) await runner.query('ROLLBACK TO SAVEPOINT reward_case');
  });
  afterAll(async () => {
    if (runner?.isTransactionActive) await runner.rollbackTransaction();
    if (runner && !runner.isReleased) {
      const [result] = await runner.query('SELECT count(*)::int AS count FROM pg_namespace WHERE nspname=$1', [schema]);
      expect(result.count).toBe(0);
      await runner.release();
    }
    if (connection?.isInitialized) await connection.destroy();
  });

  async function pending() {
    const [row] = await runner.query('SELECT pending_amount::numeric::text AS amount FROM customer_reward_tracking WHERE customer_id=7');
    return Number(row.amount);
  }

  async function seedMixedInvoice(paid = 500) {
    await runner.query('INSERT INTO products (id,exclude_from_reward) VALUES (1,false),(2,true)');
    await runner.query(`INSERT INTO sales_invoices
      (id,code,customer_id,season_id,status,payment_status,reward_policy_version,total_amount,discount_amount,final_amount,partial_payment_amount,remaining_amount,created_at)
      VALUES (1,'DEV_REWARD_FIXTURE',7,3,'confirmed','partial',1,1000,0,1000,$1::numeric,1000-$1::numeric,now())`, [paid]);
    await runner.query(`INSERT INTO sales_invoice_items
      (id,invoice_id,product_id,quantity,base_quantity,conversion_factor,unit_price,total_price)
      VALUES (11,1,1,10,10,1,60,600),(12,1,2,10,10,1,40,400)`);
