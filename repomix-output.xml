    scale: 4,
    nullable: true,
  })
  taxable_quantity?: number | null;

  @Column({ name: 'unit_cost', type: 'decimal', precision: 15, scale: 2 })
  unit_cost!: number;

  @Column({ name: 'total_cost', type: 'decimal', precision: 15, scale: 2 })
  total_cost!: number;

  @CreateDateColumn({ name: 'created_at' })
  created_at!: Date;
}
