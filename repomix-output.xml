      trade_name: 'Sản phẩm giá đề xuất fixture tích lũy',
      thumb: '',
      type: 1,
      discounted_price: '125000',
      suggested_price: '125000',
      tax_selling_price: '0',
      exclude_from_reward: true,
    } as CreateProductDto);

    expect(created.exclude_from_reward).toBe(true);
    expect(created.price).toBe('125000');
    const persisted = await products.findOneByOrFail({ id: created.id });
    expect(persisted.exclude_from_reward).toBe(true);
    expect(persisted.suggested_price).toBe('125000');
