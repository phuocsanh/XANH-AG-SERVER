  /** Tên đơn vị trả hàng tại thời điểm lập phiếu */
  @Column({ name: 'unit_name', nullable: true })
  unit_name?: string;

  /** ID đơn vị trả hàng, thường là đơn vị đã nhập trên phiếu nhập gốc */
