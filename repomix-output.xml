  @ApiProperty({ 
    description: 'Ngày cao điểm', 
    example: '30/11 – 02/12',
    nullable: true 
  })
  @Column({ type: 'text', nullable: true })
  peak_days!: string | null;

  @ApiProperty({ 
    description: 'Dữ liệu chi tiết từng ngày (JSON)'
  })
  @Column({ type: 'jsonb' })
