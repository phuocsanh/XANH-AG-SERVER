  it('TypeORM lưu và đọc lại cờ loại trừ tích lũy của sản phẩm trong schema fixture', async () => {
    await migration.up(runner);
    await runner.query('ALTER TABLE products ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (START WITH 1000)');
    const products = runner.manager.getRepository(Product);
    await products.save(products.create({
      code: 'DEV_REWARD_FLAG_FIXTURE',
      name: 'Sản phẩm fixture tích lũy',
      trade_name: 'Sản phẩm fixture tích lũy',
      exclude_from_reward: true,
    }));

    const created = await products.findOneByOrFail({ code: 'DEV_REWARD_FLAG_FIXTURE' });
    expect(created.exclude_from_reward).toBe(true);

    await products.update(created.id, { exclude_from_reward: false });
    const updated = await products.findOneByOrFail({ id: created.id });
    expect(updated.exclude_from_reward).toBe(false);
  });

  it('ProductService thật tạo và cập nhật cờ loại trừ qua repository PostgreSQL', async () => {
    await migration.up(runner);
    await runner.query('ALTER TABLE products ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (START WITH 1000)');
    const products = runner.manager.getRepository(Product);
