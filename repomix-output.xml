  it('chốt thu tiền nhiều hóa đơn rồi hoàn tác khôi phục tiền, phân bổ và tích lũy', async () => {
    await migration.up(runner);
    await seedMixedInvoice(0);
    await runner.query(`INSERT INTO sales_invoices
      (id,customer_id,season_id,status,payment_status,reward_policy_version,final_amount,partial_payment_amount,remaining_amount,created_at)
      VALUES (2,7,3,'confirmed','pending',1,1000,0,1000,now())`);
    await runner.query('INSERT INTO sales_invoice_items (id,invoice_id,product_id,quantity,base_quantity,total_price,exclude_from_reward) VALUES (13,2,2,1,1,1000,true)');
    await runner.query("INSERT INTO debt_notes (id,code,customer_id,season_id,amount,paid_amount,remaining_amount,status,source_invoices,reward_count) VALUES (9,'DEV_REWARD_DEBT',7,NULL,2000,0,2000,'active','[1,2]',0)");
