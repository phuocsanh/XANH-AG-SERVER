  it('migration up lặp không đổi mốc cũ hoặc tổng khách; down gỡ đúng schema fixture', async () => {
    await migration.up(runner);
    const baseline = await runner.manager.findOneOrFail(CustomerRewardInvoiceTracking, { where: { invoice_id: 90 } });
    expect(Number(baseline.accumulated_amount)).toBe(100);
    await runner.query('UPDATE sales_invoices SET partial_payment_amount=400 WHERE id=90');
    await migration.up(runner);
    const unchanged = await runner.manager.findOneOrFail(CustomerRewardInvoiceTracking, { where: { invoice_id: 90 } });
    expect(Number(unchanged.accumulated_amount)).toBe(100);
    expect(await pending()).toBe(1000);
    await migration.down(runner);
    const [column] = await runner.query("SELECT count(*)::int AS count FROM information_schema.columns WHERE table_schema=$1 AND column_name IN ('exclude_from_reward','reward_policy_version')", [schema]);
    expect(column.count).toBe(0);
    expect(await pending()).toBe(1000);
  });

  it('service thật ghi 300, chống cộng lặp, giữ snapshot sau đổi cờ và thu hồi đúng dòng trả', async () => {
    await migration.up(runner);
    await seedMixedInvoice();
    await service.syncInvoiceReward(runner.manager, 1);
    await service.syncInvoiceReward(runner.manager, 1);
    expect(await pending()).toBe(1300);
    await runner.query('UPDATE products SET exclude_from_reward=false WHERE id=2');
