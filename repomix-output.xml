import { CheckOwnership } from '../../common/decorators/check-ownership.decorator';

@ApiTags('Cost Item Management')
@ApiBearerAuth()
@UseGuards(JwtAuthGuard, PermissionsGuard)
@Controller('cost-items')
export class CostItemController {
