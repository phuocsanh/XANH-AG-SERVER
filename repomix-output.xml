  @Column({ name: 'borrower_name' })
  borrower_name!: string;

  @Column({ name: 'borrow_date', type: 'date' })
  borrow_date!: Date;

  @Column({ name: 'expected_return_date', type: 'date', nullable: true })
  expected_return_date?: Date | null;

  @Column({
