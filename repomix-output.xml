      {} as never,
      {} as never,
      {} as never,
      {} as never,
    );
    jest.spyOn(productService, 'findOne').mockImplementation(async (id) =>
      products.findOneBy({ id }),
    );

    const created = await productService.create({
      code: 'DEV_REWARD_SERVICE_FIXTURE',
      name: 'Sản phẩm service fixture tích lũy',
      trade_name: 'Sản phẩm service fixture tích lũy',
      exclude_from_reward: true,
