        id: allInvoices[0]?.id,
        code: allInvoices[0]?.code,
        customer_id: allInvoices[0]?.customer_id,
        customer_name: allInvoices[0]?.customer_name,
        date: allInvoices[0]?.sale_date || allInvoices[0]?.created_at,
      });
